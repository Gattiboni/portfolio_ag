---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
---

<BaseLayout
  title={site.name}
  description={`Portfolio of ${site.name}. Rebuild in progress.`}
>
  <main class="placeholder">
    <h1>{site.name}</h1>
    <p>Rebuild in progress.</p>
    <span>{Astro.currentLocale}</span>
  </main>
</BaseLayout>

<style>
  /* Scaffold placeholder: proves tokens, fonts and routes. Replaced in Phase 3. */
  .placeholder {
    display: grid;
    gap: 1rem;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--section-space) var(--content-padding);
  }
  h1 {
    color: var(--cream);
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: 400;
    line-height: var(--lh-h1);
  }
  span {
    color: var(--teal);
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
</style>
