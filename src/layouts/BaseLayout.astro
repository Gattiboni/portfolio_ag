---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { site, type Locale } from "../config/site";
import { pathWithinLocale } from "../i18n/routes";
import LocaleRedirect from "../components/LocaleRedirect.astro";
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/primitives.css";

interface Props {
  title: string;
  description: string;
  ogTitle: string;
  ogDescription: string;
}

const { title, description, ogTitle, ogDescription } = Astro.props;

// BCP 47 tags for <html lang> and hreflang; route locales stay short ("pt").
const langTag: Record<Locale, string> = { en: "en", pt: "pt-BR" };
const ogLocale: Record<Locale, string> = { en: "en_US", pt: "pt_BR" };

const locale = (Astro.currentLocale ?? site.defaultLocale) as Locale;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Same page in every locale: "" on the home pages, the route elsewhere.
const path = pathWithinLocale(Astro.url.pathname, locale);
// First-visit language detection runs on every page of the default locale
// (D004), at the top of <head>, before first paint.
---

<!doctype html>
<html lang={langTag[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Page-specific head content that must run before first paint. -->
    {locale === site.defaultLocale && <LocaleRedirect />}
    <slot name="head" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {site.locales.map((l) => (
      <link
        rel="alternate"
        hreflang={langTag[l]}
        href={getAbsoluteLocaleUrl(l, path)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={getAbsoluteLocaleUrl(site.defaultLocale, path)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta name="generator" content={Astro.generator} />
    <!-- Without JavaScript nothing adds .in, so reveals stay visible. The
         bundled stylesheet is linked after this, hence "html .rise" to win. -->
    <noscript>
      <style is:inline>
        html .rise {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
  </head>
  <body>
    <slot />
  </body>
</html>
