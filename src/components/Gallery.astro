---
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;

// Image files in the same order as t.gallery.items. Served unprocessed from
// public/img; optimisation waits until the images themselves are replaced.
const images = [
  { src: "/img/sph03.png", fitCenter: false },
  { src: "/img/sph02.png", fitCenter: false },
  { src: "/img/sph01.png", fitCenter: false },
  { src: "/img/dashboard.png", fitCenter: false },
  { src: "/img/branding.png", fitCenter: true },
];
const items = t.gallery.items.map((item, i) => ({ ...item, ...images[i] }));
---

<div class="gallery rise">
  <div class="gal-head">
    <div class="gal-label">{t.gallery.label}</div>
    <div class="gal-nav">
      <button
        class="gal-btn"
        id="galPrev"
        type="button"
        aria-label={t.a11y.galleryPrev}
      >
        ←
      </button>
      <button
        class="gal-btn"
        id="galNext"
        type="button"
        aria-label={t.a11y.galleryNext}
      >
        →
      </button>
    </div>
  </div>
  <div class="gal-viewport">
    <div class="gal-track" id="galTrack">
      {items.map((item, i) => (
        <button class="gal-item" type="button" data-i={i}>
          <div class="gal-shot">
            <img
              class:list={{ "fit-center": item.fitCenter }}
              src={item.src}
              alt={item.alt}
              loading="lazy"
            />
          </div>
          <div class="gal-cap">
            <b>{item.title}</b>
            <span>{item.caption}</span>
          </div>
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  import { initCarousel } from "../scripts/carousel";
  initCarousel();
</script>

<style is:global>
  /* Global, not scoped: selectors and specificity match production. */
  .gallery {
    margin-top: 34px;
  }
  .gal-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .gal-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .gal-nav {
    display: flex;
    gap: 8px;
  }
  .gal-btn {
    /* Production buttons kept the browser's default font; global.css sets
       buttons to inherit, so revert to the user-agent value first. */
    font: revert;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--cream-dim);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    transition:
      border-color 0.25s,
      color 0.25s,
      transform 0.2s;
  }
  .gal-btn:hover:not(:disabled) {
    border-color: var(--teal);
    color: var(--teal);
  }
  .gal-btn:disabled {
    opacity: 0.28;
    cursor: default;
  }
  .gal-viewport {
    overflow: hidden;
  }
  .gal-track {
    display: flex;
    gap: 16px;
    transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .gal-item {
    flex: 0 0 calc((100% - 32px) / 3);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.02);
    cursor: zoom-in;
    transition:
      border-color 0.3s,
      transform 0.3s;
    padding: 0;
    text-align: left;
    font: inherit;
    color: inherit;
    display: block;
  }
  .gal-item:hover {
    border-color: rgb(212 166 67 / 0.45);
    transform: translateY(-4px);
  }
  .gal-shot {
    height: 170px;
    overflow: hidden;
    position: relative;
    background: #0d1216;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gal-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: saturate(0.85) brightness(0.92);
    transition:
      filter 0.35s,
      transform 0.5s;
  }
  .gal-shot img.fit-center {
    object-position: center;
  }
  .gal-item:hover .gal-shot img {
    filter: saturate(1) brightness(1);
    transform: scale(1.03);
  }
  .gal-shot::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(17 22 27 / 0) 55%,
      rgb(17 22 27 / 0.55) 100%
    );
  }
  .gal-cap {
    padding: 12px 14px 14px;
  }
  .gal-cap b {
    display: block;
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--cream);
  }
  .gal-cap span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .gal-item {
      flex: 0 0 calc((100% - 16px) / 2);
    }
  }
  @media (max-width: 560px) {
    .gal-item {
      flex: 0 0 100%;
    }
    .gal-shot {
      height: 200px;
    }
  }
</style>
