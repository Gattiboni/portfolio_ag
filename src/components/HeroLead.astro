---
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<!-- First block after the hero: the line that used to sit under the title. -->
<div class="wrap hero-lead">
  <p class="lead rise" set:html={t.hero.subHtml} />
</div>

<style is:global>
  /* Global, not scoped: the dictionary's inline markup carries no scope
     attribute. Not a section, so the section rhythm does not apply; its own
     spacing is unchanged from production. */
  .hero-lead.wrap {
    padding-top: 40px;
    padding-bottom: 60px;
  }
  .lead {
    max-width: 640px;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--cream-dim);
  }
  .lead strong {
    color: var(--cream);
    font-weight: 500;
  }
</style>
