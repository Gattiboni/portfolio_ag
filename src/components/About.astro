---
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const a = t.about;
---

<section class="wrap" id="sobre">
  <div class="sec-head">
    <div class="sec-eyebrow rise">{a.eyebrow}</div>
    <h2 class="rise" set:html={a.titleHtml} />
  </div>
  <div class="about-grid">
    <div class="about-body">
      <p class="rise" set:html={a.p1Html} />
      <p class="rise" set:html={a.p2Html} />
      <p class="about-pull rise">{a.pull}</p>
    </div>
    <div class="about-side">
      <div class="metric rise">
        <b>{a.metric1Value}</b>
        <span>{a.metric1Label}</span>
      </div>
      <div class="metric rise" style="transition-delay:.08s">
        <b>{a.metric2Value}</b>
        <span>{a.metric2Label}</span>
      </div>
      <div class="about-facts rise" style="transition-delay:.16s">
        <div class="af-row">
          <b>{a.educationLabel}</b>
          <span>{a.education}</span>
        </div>
        <div class="af-row">
          <b>{a.toolsLabel}</b>
          <span>
            {a.tools} <span>{a.toolsGovernance}</span>
          </span>
        </div>
        <div class="af-row">
          <b>{a.languagesLabel}</b>
          <span>{a.languages}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Global, not scoped: selectors and specificity match production, and the
     dictionary's inline markup (set:html) carries no scope attribute. */
  .about-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 38px;
    }
  }
  .about-body p {
    color: var(--cream-dim);
    font-size: 1rem;
    line-height: 1.75;
  }
  .about-body p + p {
    margin-top: 18px;
  }
  .about-body strong {
    color: var(--cream);
    font-weight: 500;
  }
  .about-pull {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    line-height: 1.5;
    color: var(--cream);
    border-left: 2px solid var(--gold);
    padding-left: 22px;
    margin-top: 26px !important;
  }
  .about-side {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .metric b {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.6rem, 2.8vw, 2.15rem);
    color: var(--gold);
    display: block;
    line-height: 1.15;
  }
  .metric span {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .about-facts {
    border-top: 1px solid var(--line);
    padding-top: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .af-row b {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 5px;
  }
  .af-row span {
    font-size: 0.86rem;
    color: var(--cream-dim);
    line-height: 1.55;
  }
</style>
