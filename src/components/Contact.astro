---
import { site } from "../config/site";
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
  // Anchor id, supplied by the section list in HomePage.astro.
  id: string;
}

const { t, id } = Astro.props;
const c = t.contact;
---

<section class="wrap contact" id={id}>
  <div class="sec-eyebrow rise">{c.eyebrow}</div>
  <h2 class="rise" set:html={c.titleHtml} />
  <p class="sec-sub rise">{c.sub}</p>
  <div class="cta-row rise">
    <a class="btn btn-gold" href={`mailto:${site.email}`}>
      {c.email}
    </a>
    <a
      class="btn btn-ghost"
      href={site.linkedin}
      target="_blank"
      rel="noopener"
    >
      {c.linkedin}
    </a>
  </div>
  <p class="contact-alt rise">
    <a class="quiet-link" href={site.whatsapp} target="_blank" rel="noopener">
      {c.whatsapp}
    </a>
  </p>
</section>

<style is:global>
  /* Global, not scoped: selectors and specificity match production. */
  .contact {
    text-align: left;
  }
  /* The last section ends on the footer, not on another section: it keeps
     its own bottom space. Compound selector so it beats the section rhythm
     in primitives.css regardless of stylesheet order. */
  .contact.wrap {
    padding-bottom: 80px;
  }
  .contact h2 {
    max-width: 820px;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 38px;
  }
  /* WhatsApp as a discreet text link under the buttons, in the buttons'
     mono at the footer's size. */
  .contact-alt {
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }
</style>
