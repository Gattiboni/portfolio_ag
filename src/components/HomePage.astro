---
// The home page, composed once and rendered by both locale routes.
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../config/site";
import { getDictionary, type Dictionary } from "../i18n";
import { DEEP_DIVE_PATH } from "../i18n/routes";
import { getDeepDive } from "../lib/deep-dive/content";
import Background from "./Background.astro";
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import HeroLead from "./HeroLead.astro";
import About from "./About.astro";
import Help from "./Help.astro";
import Manifesto from "./Manifesto.astro";
import Work from "./Work.astro";
import Case from "./Case.astro";
import Projects from "./Projects.astro";
import Marquee from "./Marquee.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import PageIndex from "./PageIndex.astro";
import Lightbox from "./Lightbox.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const deepDive = getDeepDive(locale);

interface Section {
  // Anchor id, shared by both locales (published links depend on it).
  id: string;
  Component: (props: { t: Dictionary; id: string }) => unknown;
  label: string;
  inNav: boolean;
  // A decorative band rendered right before the section. It is not a section
  // of its own, so it never appears in the bar or the index.
  Before?: (props: { t: Dictionary }) => unknown;
}

// A bar entry that is not a section: a link to another page. It has no
// anchor, is never rendered as a section and stays out of the index.
interface PageLink {
  href: string;
  label: string;
  inNav: true;
  // Drawn as the bar's one highlighted item.
  accent: boolean;
}

type Entry = Section | PageLink;
const isSection = (e: Entry): e is Section => "Component" in e;

// The one list of content sections, plus the bar's links to other pages.
// The page renders the sections from here, in this order; the bar takes the
// entries marked inNav, in the same order; the index takes every section.
const entries: readonly Entry[] = [
  { id: "sobre", Component: About, label: t.nav.about, inNav: true },
  { id: "ajudo", Component: Help, label: t.nav.help, inNav: true },
  {
    id: "manifesto",
    Component: Manifesto,
    label: t.manifesto.eyebrow,
    inNav: false,
  },
  { id: "metodo", Component: Work, label: t.work.eyebrow, inNav: false },
  { id: "case", Component: Case, label: t.nav.case, inNav: true },
  {
    href: getRelativeLocaleUrl(locale, DEEP_DIVE_PATH),
    label: deepDive.nav.label,
    inNav: true,
    accent: true,
  },
  { id: "projetos", Component: Projects, label: t.nav.projects, inNav: true },
  {
    id: "contato",
    Component: Contact,
    label: t.nav.contact,
    inNav: true,
    Before: Marquee,
  },
];

const sections = entries.filter(isSection);
const navLinks = entries
  .filter((e) => e.inNav)
  .map((e) =>
    isSection(e)
      ? { href: `#${e.id}`, label: e.label }
      : { href: e.href, label: e.label, accent: e.accent },
  );
const indexItems = sections.map((s) => ({ id: s.id, label: s.label }));
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  ogTitle={t.meta.ogTitle}
  ogDescription={t.meta.ogDescription}
>
  <slot name="head" slot="head" />
  <Background />
  <Nav t={t} locale={locale} links={navLinks} />
  <Hero t={t} cueHref={`#${sections[0]?.id ?? ""}`} />
  <HeroLead t={t} />
  {sections.map(({ id, Component, Before }) => (
    <>
      {Before && <Before t={t} />}
      <Component t={t} id={id} />
    </>
  ))}
  <Footer t={t} />
  <PageIndex t={t} items={indexItems} />
  <Lightbox t={t} />
</BaseLayout>

<script>
  import { initReveal } from "../scripts/reveal";
  import { initManifestoWords } from "../scripts/manifesto-words";
  // Wraps the point of view's words before the reveal observes .rise, so the
  // two paragraphs it takes over are never handed to the reveal.
  initManifestoWords();
  initReveal();
</script>
