---
import type { Dictionary } from "../i18n";
import ChatDemo from "./ChatDemo.astro";

interface Props {
  t: Dictionary;
  // Anchor id, supplied by the section list in HomePage.astro.
  id: string;
}

const { t, id } = Astro.props;
const c = t.case;
// One tone per medallion layer, in data order.
const tones = ["bronze", "silver", "gold"] as const;
const layerDelay = (i: number) =>
  i === 0 ? undefined : `transition-delay:${(i * 0.1).toFixed(1)}s`;
const factDelay = (i: number) =>
  i === 0 ? undefined : `transition-delay:${(i * 0.08).toFixed(2)}s`;
---

<section class="flagship" id={id}>
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-eyebrow rise">{c.eyebrow}</div>
      <h2 class="rise" set:html={c.titleHtml} />
      <p class="sec-sub rise">{c.sub}</p>
    </div>

    <div class="med-flow">
      <!-- Effect C: the rail the data travels along, above 760px. -->
      <div class="med-rail" aria-hidden="true">
        <i></i>
        <b></b>
      </div>
      {c.layers.map((layer, i) => (
        <>
          {i > 0 && (
            <div class="med-arrow" aria-hidden="true">
              →
            </div>
          )}
          <div class={`med ${tones[i]} rise`} style={layerDelay(i)}>
            <div class="med-tag">{layer.tag}</div>
            <h3>{layer.title}</h3>
            <p>{layer.text}</p>
          </div>
        </>
      ))}
    </div>

    <ChatDemo t={t} />

    <div class="flag-detail">
      <div class="rise">
        <h3 set:html={c.detailTitleHtml} />
        <p>{c.detailP1}</p>
        <p>{c.detailP2}</p>
        <div class="chips">
          {c.chips.map((chip) => (
            <span class="chip">{chip}</span>
          ))}
        </div>
      </div>
      <div class="flag-facts">
        {c.facts.map((fact, i) => (
          <div class="fact rise" style={factDelay(i)}>
            <b>{fact.title}</b>
            <span>{fact.text}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Global, not scoped: selectors and specificity match production, and the
     dictionary's inline markup (set:html) carries no scope attribute. */
  .flagship {
    background: linear-gradient(180deg, var(--panel) 0%, transparent 100%);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .med-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 0;
    align-items: stretch;
    margin-top: 14px;
  }
  .med {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px 24px;
    background: rgb(255 255 255 / 0.015);
  }
  /* Production listed .med after .rise, so the card's transition and hover
     lift won over the reveal's. The extra .med-flow keeps that outcome
     regardless of stylesheet order. */
  .med-flow .med {
    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
      background 0.35s ease;
  }
  .med-flow .med:hover {
    transform: translateY(-5px);
  }
  .med-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .med-tag::before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .med.bronze .med-tag {
    color: var(--bronze);
  }
  .med.bronze .med-tag::before {
    background: var(--bronze);
  }
  .med.silver .med-tag {
    color: var(--silver);
  }
  .med.silver .med-tag::before {
    background: var(--silver);
  }
  .med.gold .med-tag {
    color: var(--gold);
  }
  .med.gold .med-tag::before {
    background: var(--gold);
  }
  .med.bronze:hover {
    border-color: rgb(166 107 63 / 0.5);
  }
  .med.silver:hover {
    border-color: rgb(159 168 173 / 0.5);
  }
  .med.gold:hover {
    border-color: rgb(212 166 67 / 0.6);
    background: var(--gold-soft);
  }
  .med h3 {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1rem;
    margin-bottom: 8px;
  }
  .med p {
    font-size: 0.85rem;
    color: var(--cream-dim);
    line-height: 1.6;
  }
  .med-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 10px;
    color: var(--muted);
    font-family: var(--font-mono);
  }
  @media (max-width: 760px) {
    .med-flow {
      grid-template-columns: 1fr;
    }
    .med-arrow {
      transform: rotate(90deg);
      padding: 8px 0;
    }
  }

  /* Effect C: the data travels bronze, silver, gold. Values from the approved
     mock. Above 760px a rail replaces the arrows; at 760px and below the
     cards stack and the arrows stay. Static by default: the whole rail,
     faint, and the cards as they always were. */
  .med-flow {
    position: relative;
  }
  .med-rail {
    display: none;
  }
  @media (min-width: 761px) {
    .med-flow {
      grid-template-columns: repeat(3, 1fr);
      gap: 34px;
    }
    .med-arrow {
      display: none;
    }
    .med-rail {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: -22px;
      height: 1px;
      background: var(--line);
    }
    .med-rail i {
      position: absolute;
      inset: 0;
      transform-origin: left center;
      background: linear-gradient(
        90deg,
        var(--bronze),
        var(--silver) 50%,
        var(--gold)
      );
      opacity: 0.35;
    }
    .med-rail b {
      position: absolute;
      top: -4px;
      left: 0;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--cream);
      box-shadow: 0 0 16px 4px rgb(212 166 67 / 0.55);
      opacity: 0;
    }
  }

  /* How much a card is lit, 0 to 1. The scroll animation drives only this
     number; border, glow and opacity are derived from it in ordinary rules.
     That way the hover rules above, which are more specific, still win on a
     lit card: an animation that set border-color itself would override the
     hover's border for good. */
  @property --med-lit {
    syntax: "<number>";
    inherits: false;
    initial-value: 1;
  }
  @keyframes med-ignite {
    from {
      --med-lit: 0;
    }
    to {
      --med-lit: 1;
    }
  }
  @keyframes med-rail-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes med-rail-travel {
    0% {
      left: 0;
      opacity: 0;
    }
    6%,
    94% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  /* Scale and travel, so not under reduced motion: the static version stays.
     Longhands only, as in Hero.astro: the minifier folds a timeline into the
     animation shorthand, which browsers then reject. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .med.bronze {
        --med-rgb: 166 107 63;
      }
      .med.silver {
        --med-rgb: 159 168 173;
      }
      .med.gold {
        --med-rgb: 212 166 67;
      }
      /* Lit from a dim start, instead of the fade-in from below: transform
         none cancels the .rise offset (the hover lift is more specific and
         still applies), and the opacity below outranks .rise and .rise.in. */
      .med-flow .med {
        transform: none;
        border-color: color-mix(
          in srgb,
          rgb(var(--med-rgb) / 0.6) calc(var(--med-lit) * 100%),
          var(--line)
        );
        box-shadow: 0 0 44px -14px
          rgb(var(--med-rgb) / calc(0.55 * var(--med-lit)));
        /* Stacked cards: each one lights up as it enters the screen, over
           the slice the mock gives the first card. */
        animation-name: med-ignite;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 55% entry 90%;
      }
      .med-flow .med.rise {
        opacity: calc(0.35 + 0.65 * var(--med-lit));
      }

      /* Side by side: one timeline for the row; the rail draws across it and
         each card lights up as the rail's tip reaches it. */
      @media (min-width: 761px) {
        .med-flow {
          view-timeline: --med-flow block;
        }
        .med-flow .med {
          animation-timeline: --med-flow;
        }
        .med-flow .med.silver {
          animation-range: entry 95% cover 38%;
        }
        .med-flow .med.gold {
          animation-range: cover 42% cover 56%;
        }
        .med-rail i {
          opacity: 1;
          animation-name: med-rail-draw;
          animation-duration: auto;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: --med-flow;
          animation-range: entry 55% cover 55%;
        }
        .med-rail b {
          animation-name: med-rail-travel;
          animation-duration: auto;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: --med-flow;
          animation-range: entry 55% cover 55%;
        }
      }
    }
  }
  .flag-detail {
    margin-top: 64px;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 820px) {
    .flag-detail {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
  .flag-detail h3 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    margin-bottom: 14px;
  }
  .flag-detail h3 em {
    color: var(--gold);
    font-style: italic;
    font-weight: 400;
  }
  .flag-detail p {
    color: var(--cream-dim);
    font-size: 0.95rem;
  }
  .flag-detail p + p {
    margin-top: 14px;
  }
  .flag-facts {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .fact {
    border: 1px solid var(--line);
    border-left: 2px solid var(--teal);
    border-radius: 10px;
    padding: 16px 18px;
    background: rgb(255 255 255 / 0.015);
  }
  .fact b {
    display: block;
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--cream);
  }
  .fact span {
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
