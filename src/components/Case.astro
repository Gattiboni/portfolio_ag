---
import type { Dictionary } from "../i18n";
import ChatDemo from "./ChatDemo.astro";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const c = t.case;
// One tone per medallion layer, in data order.
const tones = ["bronze", "silver", "gold"] as const;
const layerDelay = (i: number) =>
  i === 0 ? undefined : `transition-delay:${(i * 0.1).toFixed(1)}s`;
const factDelay = (i: number) =>
  i === 0 ? undefined : `transition-delay:${(i * 0.08).toFixed(2)}s`;
---

<section class="flagship" id="case">
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-eyebrow rise">{c.eyebrow}</div>
      <h2 class="rise" set:html={c.titleHtml} />
      <p class="sec-sub rise">{c.sub}</p>
    </div>

    <div class="med-flow">
      {c.layers.map((layer, i) => (
        <>
          {i > 0 && (
            <div class="med-arrow" aria-hidden="true">
              →
            </div>
          )}
          <div class={`med ${tones[i]} rise`} style={layerDelay(i)}>
            <div class="med-tag">{layer.tag}</div>
            <h3>{layer.title}</h3>
            <p>{layer.text}</p>
          </div>
        </>
      ))}
    </div>

    <ChatDemo t={t} />

    <div class="flag-detail">
      <div class="rise">
        <h3 set:html={c.detailTitleHtml} />
        <p>{c.detailP1}</p>
        <p>{c.detailP2}</p>
        <div class="chips">
          {c.chips.map((chip) => (
            <span class="chip">{chip}</span>
          ))}
        </div>
      </div>
      <div class="flag-facts">
        {c.facts.map((fact, i) => (
          <div class="fact rise" style={factDelay(i)}>
            <b>{fact.title}</b>
            <span>{fact.text}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Global, not scoped: selectors and specificity match production, and the
     dictionary's inline markup (set:html) carries no scope attribute. */
  .flagship {
    background: linear-gradient(180deg, var(--panel) 0%, transparent 100%);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .med-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 0;
    align-items: stretch;
    margin-top: 14px;
  }
  .med {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px 24px;
    background: rgb(255 255 255 / 0.015);
  }
  /* Production listed .med after .rise, so the card's transition and hover
     lift won over the reveal's. The extra .med-flow keeps that outcome
     regardless of stylesheet order. */
  .med-flow .med {
    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
      background 0.35s ease;
  }
  .med-flow .med:hover {
    transform: translateY(-5px);
  }
  .med-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .med-tag::before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .med.bronze .med-tag {
    color: var(--bronze);
  }
  .med.bronze .med-tag::before {
    background: var(--bronze);
  }
  .med.silver .med-tag {
    color: var(--silver);
  }
  .med.silver .med-tag::before {
    background: var(--silver);
  }
  .med.gold .med-tag {
    color: var(--gold);
  }
  .med.gold .med-tag::before {
    background: var(--gold);
  }
  .med.bronze:hover {
    border-color: rgb(166 107 63 / 0.5);
  }
  .med.silver:hover {
    border-color: rgb(159 168 173 / 0.5);
  }
  .med.gold:hover {
    border-color: rgb(212 166 67 / 0.6);
    background: var(--gold-soft);
  }
  .med h3 {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1rem;
    margin-bottom: 8px;
  }
  .med p {
    font-size: 0.85rem;
    color: var(--cream-dim);
    line-height: 1.6;
  }
  .med-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 10px;
    color: var(--muted);
    font-family: var(--font-mono);
  }
  @media (max-width: 760px) {
    .med-flow {
      grid-template-columns: 1fr;
    }
    .med-arrow {
      transform: rotate(90deg);
      padding: 8px 0;
    }
  }
  .flag-detail {
    margin-top: 64px;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 820px) {
    .flag-detail {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
  .flag-detail h3 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    margin-bottom: 14px;
  }
  .flag-detail h3 em {
    color: var(--gold);
    font-style: italic;
    font-weight: 400;
  }
  .flag-detail p {
    color: var(--cream-dim);
    font-size: 0.95rem;
  }
  .flag-detail p + p {
    margin-top: 14px;
  }
  .flag-facts {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .fact {
    border: 1px solid var(--line);
    border-left: 2px solid var(--teal);
    border-radius: 10px;
    padding: 16px 18px;
    background: rgb(255 255 255 / 0.015);
  }
  .fact b {
    display: block;
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--cream);
  }
  .fact span {
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
