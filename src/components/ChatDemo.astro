---
// Illustrative chat demo inside the flagship case. Restyled in the
// portfolio's own palette and type (D005); structure, sizes, radii, spacing
// and motion are unchanged from production.
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const c = t.chat;
---

<div class="chat-stage rise">
  <div
    class="chat"
    id="chatCard"
    aria-label={t.a11y.chatDemo}
    data-scenes={JSON.stringify(c.scenes)}
    data-sql-label={c.sqlLabel}
  >
    <div class="chat-head">
      <div class="chat-avatar" aria-hidden="true">
        {c.avatar}
      </div>
      <div class="chat-id">
        <b>{c.name}</b>
        <span>
          <i class="st" aria-hidden="true"></i>
          {c.status}
        </span>
      </div>
    </div>
    <div class="chat-body" id="chatBody" aria-hidden="true"></div>
    <div class="chat-input" aria-hidden="true">
      <div class="chat-field">{c.field}</div>
      <div class="chat-send">↑</div>
    </div>
  </div>
  <div class="chat-note">{c.note}</div>
</div>

<script>
  import { initChatDemo } from "../scripts/chat-demo";
  initChatDemo();
</script>

<style is:global>
  /* Global, not scoped: bubbles are created at runtime by chat-demo.ts and
     carry no scope attribute. */
  .chat-stage {
    margin-top: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .chat {
    width: 100%;
    max-width: 680px;
    background: var(--panel);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.45);
  }
  .chat-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: var(--panel-2);
    border-bottom: 1px solid var(--line);
  }
  .chat-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    flex: 0 0 36px;
    background: var(--gold);
    color: var(--on-gold);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0.02em;
  }
  .chat-id b {
    display: block;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--cream);
    line-height: 1.25;
  }
  .chat-id span {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .chat-id .st {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
    display: inline-block;
  }
  .chat-body {
    min-height: 320px;
    padding: 20px 18px;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-family: var(--font-body);
  }
  .msg {
    max-width: 82%;
    padding: 11px 15px;
    border-radius: 16px;
    font-size: 0.86rem;
    line-height: 1.55;
    animation: pop 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .msg.user {
    align-self: flex-end;
    background: var(--gold);
    color: var(--on-gold);
    border-bottom-right-radius: 5px;
    font-weight: 500;
  }
  .msg.bot {
    align-self: flex-start;
    background: var(--panel-2);
    color: var(--cream);
    border: 1px solid var(--line);
    border-bottom-left-radius: 5px;
  }
  .msg.bot .txt {
    display: block;
  }
  .typing {
    display: flex;
    gap: 5px;
    align-items: center;
    padding: 14px 16px;
  }
  .typing i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--muted);
    animation: tblink 1.2s ease-in-out infinite;
  }
  .typing i:nth-child(2) {
    animation-delay: 0.18s;
  }
  .typing i:nth-child(3) {
    animation-delay: 0.36s;
  }
  @keyframes tblink {
    0%,
    100% {
      opacity: 0.25;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }
  .sql {
    margin-top: 10px;
    border-top: 1px solid var(--line);
    padding-top: 9px;
  }
  .sql summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    user-select: none;
  }
  .sql summary::-webkit-details-marker {
    display: none;
  }
  .sql summary::before {
    content: "▸";
    transition: transform 0.2s;
    color: var(--gold);
  }
  .sql[open] summary::before {
    transform: rotate(90deg);
  }
  .sql pre {
    margin-top: 9px;
    background: var(--bg);
    border-radius: 8px;
    padding: 11px 13px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--cream-dim);
    white-space: pre-wrap;
    word-break: break-word;
  }
  .chat-input {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    background: var(--panel);
    border-top: 1px solid var(--line);
  }
  .chat-field {
    flex: 1;
    background: var(--panel-2);
    border-radius: var(--radius-pill);
    padding: 11px 18px;
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--muted);
  }
  .chat-send {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    flex: 0 0 38px;
    background: var(--gold);
    color: var(--on-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
  }
  .chat-note {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    letter-spacing: 0.05em;
    text-align: center;
  }
</style>
