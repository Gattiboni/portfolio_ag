---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Locale } from "../config/site";
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
  locale: Locale;
  // The bar's share of the section list in HomePage.astro, in page order.
  links: readonly { href: string; label: string }[];
}

const { t, locale, links } = Astro.props;

const langs = [
  {
    code: "pt",
    text: "PT",
    hreflang: "pt-BR",
    label: t.a11y.langPt,
    href: getRelativeLocaleUrl("pt"),
  },
  {
    code: "en",
    text: "EN",
    hreflang: "en",
    label: t.a11y.langEn,
    href: getRelativeLocaleUrl("en"),
  },
] as const;
---

<nav>
  <div class="nav-inner">
    <a class="brand" href="#top" set:html={t.nav.brandHtml} />
    <div class="nav-right">
      <div class="nav-links">
        {links.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
      </div>
      <div class="lang" role="group" aria-label={t.a11y.langGroup}>
        {langs.map((l) => (
          <a
            href={l.href}
            hreflang={l.hreflang}
            class:list={{ on: l.code === locale }}
            aria-current={l.code === locale ? "page" : undefined}
            aria-label={l.label}
            data-lang-link={l.code}
          >
            {l.code === "pt" ? (
              <svg viewBox="0 0 20 14" aria-hidden="true">
                <rect width="20" height="14" fill="#009C3B" />
                <path d="M10 1.6 18.4 7 10 12.4 1.6 7Z" fill="#FFDF00" />
                <circle cx="10" cy="7" r="3" fill="#002776" />
              </svg>
            ) : (
              <svg viewBox="0 0 20 14" aria-hidden="true">
                <rect width="20" height="14" fill="#B22234" />
                <g fill="#FFFFFF">
                  <rect y="1.08" width="20" height="1.07" />
                  <rect y="3.23" width="20" height="1.07" />
                  <rect y="5.38" width="20" height="1.07" />
                  <rect y="7.54" width="20" height="1.07" />
                  <rect y="9.69" width="20" height="1.07" />
                  <rect y="11.85" width="20" height="1.07" />
                </g>
                <rect width="8" height="7.54" fill="#3C3B6E" />
              </svg>
            )}
            {l.text}
          </a>
        ))}
      </div>
      <button
        class="menu-btn"
        type="button"
        popovertarget="nav-menu"
        aria-controls="nav-menu"
        aria-label={t.a11y.menu}
        data-menu-button
      >
        <svg viewBox="0 0 12 10" aria-hidden="true">
          <path
            d="M0 1.5h12M0 5h12M0 8.5h12"
            stroke="currentColor"
            stroke-width="1.2"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile menu: a sibling of <nav>, not a child, so its backdrop blur reads
     the page instead of the bar's own (already blurred) layer. -->
<div class="nav-menu" id="nav-menu" popover>
  <div class="nav-menu-inner">
    {links.map((l) => (
      <a href={l.href}>{l.label}</a>
    ))}
  </div>
</div>

<script>
  import { initLangSwitch } from "../scripts/lang-switch";
  import { initNavMenu } from "../scripts/nav-menu";
  initLangSwitch();
  initNavMenu();
</script>

<style is:global>
  /* Global, not scoped: selectors and specificity match production. */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    backdrop-filter: blur(14px);
    background: rgb(17 22 27 / 0.74);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 16px var(--content-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    color: var(--cream);
    text-decoration: none;
  }
  .brand em {
    font-style: italic;
    color: var(--gold);
    font-weight: 400;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .nav-links {
    display: flex;
    gap: 24px;
  }
  .nav-links a,
  .nav-menu a {
    color: var(--cream-dim);
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.25s;
    white-space: nowrap;
  }
  .nav-links a:hover,
  .nav-links a:focus-visible,
  .nav-menu a:hover,
  .nav-menu a:focus-visible {
    color: var(--gold);
  }
  @media (max-width: 820px) {
    .nav-links {
      display: none;
    }
  }

  /* Language switch. Production used <button>; these are links now (D004).
     line-height and font-weight restore what the button defaults gave. */
  .lang {
    display: flex;
    gap: 6px;
  }
  .lang a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 6px 12px;
    color: var(--cream-dim);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition:
      border-color 0.25s,
      color 0.25s;
  }
  .lang a:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  .lang a.on {
    border-color: var(--gold);
    color: var(--gold);
    background: var(--gold-soft);
  }
  .lang a:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
    border-radius: var(--radius-pill);
  }
  .lang svg {
    width: 17px;
    height: 12px;
    border-radius: 2px;
    display: block;
    flex: 0 0 17px;
  }

  /* Mobile menu (new in the port): a round control in the language pills'
     visual language, shown only where the bar's links are hidden. */
  .menu-btn {
    display: none;
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--cream-dim);
    cursor: pointer;
    transition:
      border-color 0.25s,
      color 0.25s;
  }
  .menu-btn:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  .menu-btn[aria-expanded="true"] {
    border-color: var(--gold);
    color: var(--gold);
    background: var(--gold-soft);
  }
  .menu-btn:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }
  .menu-btn svg {
    width: 12px;
    height: 10px;
  }
  @media (max-width: 820px) {
    /* Only the switch and the menu button remain here; 4px keeps the bar on
       one line down to 360px wide. */
    .nav-right {
      gap: 4px;
    }
    .menu-btn {
      display: inline-flex;
    }
  }

  /* Hidden by default so browsers without popover support never show it. */
  .nav-menu {
    display: none;
  }
  .nav-menu:popover-open {
    display: block;
    position: fixed;
    /* nav-menu.ts sets top to the bar's measured bottom edge. */
    inset: 61px 0 auto;
    width: auto;
    height: auto;
    max-width: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    color: var(--cream);
    backdrop-filter: blur(14px);
    background: rgb(17 22 27 / 0.74);
  }
  .nav-menu-inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 6px var(--content-padding) 14px;
    display: flex;
    flex-direction: column;
  }
  .nav-menu a {
    padding: 12px 0;
  }
  /* Older Safari only understands the prefixed property. Kept in its own
     block because the minifier merges sibling declarations and drops one. */
  @supports (-webkit-backdrop-filter: none) {
    nav {
      -webkit-backdrop-filter: blur(14px);
    }
    /* Separate rule: an unknown :popover-open would void the whole list. */
    .nav-menu:popover-open {
      -webkit-backdrop-filter: blur(14px);
    }
  }
  @media (min-width: 821px) {
    .nav-menu:popover-open {
      display: none;
    }
  }
</style>
