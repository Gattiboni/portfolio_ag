---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Locale } from "../config/site";
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
  locale: Locale;
  // The bar's share of the section list in HomePage.astro, in page order;
  // on other pages, their own links (the deep dive: one link back).
  // `accent` marks the one highlighted item (the deep dive on the home page).
  links: readonly { href: string; label: string; accent?: boolean }[];
  // Where the name leads: the top of the home page by default.
  brandHref?: string;
  // The current page inside its locale ("" on the home pages), so the
  // language switch opens the same page in the other language.
  path?: string;
}

const { t, locale, links, brandHref = "#top", path = "" } = Astro.props;

const langs = [
  {
    code: "pt",
    text: "PT",
    hreflang: "pt-BR",
    label: t.a11y.langPt,
    href: getRelativeLocaleUrl("pt", path),
  },
  {
    code: "en",
    text: "EN",
    hreflang: "en",
    label: t.a11y.langEn,
    href: getRelativeLocaleUrl("en", path),
  },
] as const;
---

<nav>
  <div class="nav-inner">
    <a class="brand" href={brandHref} set:html={t.nav.brandHtml} />
    <div class="nav-right">
      <div class="nav-links">
        {links.map((l) => (
          <a href={l.href} class:list={{ "nav-accent": l.accent }}>
            {l.label}
          </a>
        ))}
      </div>
      <div class="lang" role="group" aria-label={t.a11y.langGroup}>
        {langs.map((l) => (
          <a
            href={l.href}
            hreflang={l.hreflang}
            class:list={{ on: l.code === locale }}
            aria-current={l.code === locale ? "page" : undefined}
            aria-label={l.label}
            data-lang-link={l.code}
          >
            {l.code === "pt" ? (
              <svg viewBox="0 0 20 14" aria-hidden="true">
                <rect width="20" height="14" fill="#009C3B" />
                <path d="M10 1.6 18.4 7 10 12.4 1.6 7Z" fill="#FFDF00" />
                <circle cx="10" cy="7" r="3" fill="#002776" />
              </svg>
            ) : (
              <svg viewBox="0 0 20 14" aria-hidden="true">
                <rect width="20" height="14" fill="#B22234" />
                <g fill="#FFFFFF">
                  <rect y="1.08" width="20" height="1.07" />
                  <rect y="3.23" width="20" height="1.07" />
                  <rect y="5.38" width="20" height="1.07" />
                  <rect y="7.54" width="20" height="1.07" />
                  <rect y="9.69" width="20" height="1.07" />
                  <rect y="11.85" width="20" height="1.07" />
                </g>
                <rect width="8" height="7.54" fill="#3C3B6E" />
              </svg>
            )}
            {l.text}
          </a>
        ))}
      </div>
      <button
        class="menu-btn"
        type="button"
        popovertarget="nav-menu"
        aria-controls="nav-menu"
        aria-label={t.a11y.menu}
        data-menu-button
      >
        <svg viewBox="0 0 12 10" aria-hidden="true">
          <path
            d="M0 1.5h12M0 5h12M0 8.5h12"
            stroke="currentColor"
            stroke-width="1.2"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile menu: a sibling of <nav>, not a child, so its backdrop blur reads
     the page instead of the bar's own (already blurred) layer. -->
<div class="nav-menu" id="nav-menu" popover>
  <div class="nav-menu-inner">
    {links.map((l) => (
      <a href={l.href} class:list={{ "nav-accent": l.accent }}>
        {l.label}
      </a>
    ))}
  </div>
</div>

<script>
  import { initLangSwitch } from "../scripts/lang-switch";
  import { initNavMenu } from "../scripts/nav-menu";
  initLangSwitch();
  initNavMenu();
</script>

<style is:global>
  /* Global, not scoped: selectors and specificity match production. */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    backdrop-filter: blur(14px);
    background: rgb(17 22 27 / 0.74);
    border-bottom: 1px solid var(--line);
  }
  /* The bar needs 360px to fit on one line. Below that, --nav-squeeze grows
     by 1px per pixel lost, and the side padding, the gap and the name give
     back 0.3, 0.25 and about 0.35 of it (48px at 320px wide for the 40px
     missing). It is 0 from 360px up, so nothing changes there. A fluid
     value, not a breakpoint.

     The links need about 1000px at full spacing (Portuguese, the longer
     language). Below that, --links-squeeze grows by 1px per pixel lost, up to
     100px, and the spaces give it back: the five gaps between links 0.12 each,
     the gap before the switch 0.1, the side padding 0.08 each, the gap after
     the name 0.06 and the highlighted item's pill 0.04 a side. At 900px every
     label still fits on one line; below that the links move to the menu
     (the one breakpoint, at the end of this stylesheet). */
  .nav-inner {
    --nav-squeeze: max(0px, 360px - 100vw);
    --links-squeeze: clamp(0px, 1000px - 100vw, 100px);
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 16px
      calc(
        var(--content-padding) - var(--nav-squeeze) * 0.3 -
          var(--links-squeeze) * 0.08
      );
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(18px - var(--nav-squeeze) * 0.25 - var(--links-squeeze) * 0.06);
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: calc(1.05rem - var(--nav-squeeze) * 0.05);
    white-space: nowrap;
    letter-spacing: 0.02em;
    color: var(--cream);
    text-decoration: none;
  }
  .brand em {
    font-style: italic;
    color: var(--gold);
    font-weight: 400;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: calc(24px - var(--links-squeeze) * 0.1);
  }
  .nav-links {
    display: flex;
    gap: calc(24px - var(--links-squeeze) * 0.12);
  }
  .nav-links a,
  .nav-menu a {
    color: var(--cream-dim);
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.25s;
    white-space: nowrap;
  }
  .nav-links a:hover,
  .nav-links a:focus-visible,
  .nav-menu a:hover,
  .nav-menu a:focus-visible {
    color: var(--gold);
  }

  /* The one highlighted item: gold, in a thin gold pill, in the language of
     the switch's active pill. The negative block margin takes back the
     pill's padding, so the item keeps the row height of the others. */
  .nav-links a.nav-accent {
    color: var(--gold);
    border: 1px solid var(--gold);
    border-radius: var(--radius-pill);
    background: var(--gold-soft);
    padding: 3px calc(11px - var(--links-squeeze) * 0.04);
    margin-block: -4px;
  }
  .nav-links a.nav-accent:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
    border-radius: var(--radius-pill);
  }
  .nav-menu a.nav-accent {
    color: var(--gold);
  }

  /* Language switch. Production used <button>; these are links now (D004).
     line-height and font-weight restore what the button defaults gave. */
  .lang {
    display: flex;
    gap: 6px;
  }
  .lang a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 6px 12px;
    color: var(--cream-dim);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition:
      border-color 0.25s,
      color 0.25s;
  }
  .lang a:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  .lang a.on {
    border-color: var(--gold);
    color: var(--gold);
    background: var(--gold-soft);
  }
  .lang a:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
    border-radius: var(--radius-pill);
  }
  .lang svg {
    width: 17px;
    height: 12px;
    border-radius: 2px;
    display: block;
    flex: 0 0 17px;
  }

  /* Mobile menu (new in the port): a round control in the language pills'
     visual language, shown only where the bar's links are hidden. */
  .menu-btn {
    display: none;
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--cream-dim);
    cursor: pointer;
    transition:
      border-color 0.25s,
      color 0.25s;
  }
  .menu-btn:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  .menu-btn[aria-expanded="true"] {
    border-color: var(--gold);
    color: var(--gold);
    background: var(--gold-soft);
  }
  .menu-btn:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }
  .menu-btn svg {
    width: 12px;
    height: 10px;
  }

  /* Hidden by default so browsers without popover support never show it. */
  .nav-menu {
    display: none;
  }
  /* Shown only below the breakpoint, at the end of this stylesheet. */
  .nav-menu:popover-open {
    display: none;
    position: fixed;
    /* nav-menu.ts sets top to the bar's measured bottom edge. */
    inset: 61px 0 auto;
    width: auto;
    height: auto;
    max-width: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    color: var(--cream);
    backdrop-filter: blur(14px);
    background: rgb(17 22 27 / 0.74);
  }
  .nav-menu-inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 6px var(--content-padding) 14px;
    display: flex;
    flex-direction: column;
  }
  .nav-menu a {
    padding: 12px 0;
  }
  /* Older Safari only understands the prefixed property. Kept in its own
     block because the minifier merges sibling declarations and drops one. */
  @supports (-webkit-backdrop-filter: none) {
    nav {
      -webkit-backdrop-filter: blur(14px);
    }
    /* Separate rule: an unknown :popover-open would void the whole list. */
    .nav-menu:popover-open {
      -webkit-backdrop-filter: blur(14px);
    }
  }

  /* The one breakpoint of the bar: below 900px the links move to the menu.
     It was 820px; with the deep-dive item the links need 900px even with
     every space squeezed (see .nav-inner). nav-menu.ts follows it by watching
     the menu button, so this is the only place that names it. */
  @media (max-width: 899px) {
    .nav-inner {
      --links-squeeze: 0px;
    }
    .nav-links {
      display: none;
    }
    /* Only the switch and the menu button remain here; 4px keeps the bar on
       one line down to 360px wide. */
    .nav-right {
      gap: 4px;
    }
    .menu-btn {
      display: inline-flex;
    }
    .nav-menu:popover-open {
      display: block;
    }
  }
</style>
