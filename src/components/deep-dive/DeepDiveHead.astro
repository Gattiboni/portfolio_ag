---
import type { DeepDive } from "../../lib/deep-dive/content";

interface Props {
  dd: DeepDive;
}

const { page } = Astro.props.dd;
// The header shares its view-transition name with the card on the home page.
---

<header class="dd-head">
  <div class="dd-eyebrow">{page.eyebrow}</div>
  <h1 set:html={page.titleHtml} />
  <div class="dd-facts">
    {page.facts.map((f) => (
      <div>
        <b>{f.value}</b>
        <span>{f.label}</span>
      </div>
    ))}
  </div>
</header>

<style is:global>
  /* Values from the approved deep-dive mock. Space above comes from the
     section rule (D022); the 30px below separates the header from the map
     inside the same section. */
  .dd-head {
    max-width: var(--content-width);
    padding-bottom: 30px;
    view-transition-name: deep-dive;
  }
  .dd-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 14px;
  }
  .dd-head h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.8rem, 3.4vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    max-width: 900px;
  }
  .dd-head h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--gold);
  }
  .dd-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 44px;
    margin-top: 24px;
  }
  .dd-facts b {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.55rem;
    color: var(--gold);
    line-height: 1.15;
  }
  .dd-facts span {
    font-size: 0.78rem;
    color: var(--muted);
  }
</style>
