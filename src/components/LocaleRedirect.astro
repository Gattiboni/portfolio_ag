---
// First-visit language detection for "/" only (D004). Runs inline in <head>
// before first paint. A stored "pt" choice, or no stored choice and a browser
// language starting with "pt", sends the visitor to the Portuguese page;
// anything else stays. Keeps the anchor and replaces the history entry so
// Back does not loop. /pt/ never redirects: an explicit URL wins.
// Plain inline script, so it behaves the same on any static host.
import { getRelativeLocaleUrl } from "astro:i18n";

const target = getRelativeLocaleUrl("pt");
---

<script is:inline define:vars={{ target }}>
  let saved = null;
  try {
    saved = localStorage.getItem("lang");
  } catch {
    // Storage unavailable: fall back to the browser language.
  }
  const browserPt = (navigator.language || "").toLowerCase().startsWith("pt");
  if (saved === "pt" || (saved !== "en" && browserPt)) {
    location.replace(target + location.hash);
  }
</script>
