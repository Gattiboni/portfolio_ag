---
import type { Dictionary } from "../i18n";
import Gallery from "./Gallery.astro";

interface Props {
  t: Dictionary;
  // Anchor id, supplied by the section list in HomePage.astro.
  id: string;
}

const { t, id } = Astro.props;
const p = t.projects;
// Staggered reveal, as in production.
const delay = (i: number) =>
  i === 0 ? undefined : `transition-delay:${(i * 0.07).toFixed(2)}s`;
---

<section class="wrap" id={id}>
  <div class="sec-head">
    <div class="sec-eyebrow rise">{p.eyebrow}</div>
    <h2 class="rise" set:html={p.titleHtml} />
    <p class="sec-sub rise">{p.sub}</p>
  </div>
  <div class="grid">
    {p.items.map((item, i) => (
      <div class="card rise" style={delay(i)}>
        <div class="card-kind">{item.kind}</div>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
        <div class="tools">{item.tools}</div>
      </div>
    ))}
  </div>

  <Gallery t={t} />
</section>
